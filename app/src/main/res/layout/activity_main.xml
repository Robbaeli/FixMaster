<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/fm_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/centerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Titel -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/fm_text_primary"
            android:gravity="center"
            android:textAlignment="center" />

        <!-- Underrubrik -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitle_scan"
            android:textSize="16sp"
            android:textColor="@color/fm_text_secondary"
            android:gravity="center"
            android:textAlignment="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="28dp" />

        <!-- QR-knapp utan glow/shadow men med ripple -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_scan_qr"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:fabCustomSize="100dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="@string/cd_scan_qr"
            app:tint="@android:color/white"
            app:backgroundTint="@color/fm_primary"
            app:rippleColor="@color/fm_ripple"

            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/tvScanLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/scan_label"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/fm_text_primary"
            android:gravity="center"
            android:textAlignment="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="34dp" />

        <!-- Dummy-knapp för Sprint 1 (flat via temat) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/test2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_dummy_report"
            android:maxLines="1"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconPadding="12dp"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
