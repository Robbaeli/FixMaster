<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fm_background"
    android:padding="24dp">

    <ImageView
        android:layout_width="196dp"
        android:layout_height="164dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_fixmaster_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="124dp"
        android:layout_marginTop="140dp"
        android:text="@string/fixmaster2"
        android:textColor="@color/fm_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateReport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/skapa_felanm_lan"
            android:textAllCaps="false"
            android:textColor="@color/fm_on_primary"
            app:backgroundTint="@color/fm_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyReports"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/mina_felanm_lningar"
            android:textAllCaps="false"
            android:textColor="@color/fm_on_primary"
            app:backgroundTint="@color/fm_primary" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminView"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/admin"
                android:textAllCaps="false"
                android:textColor="@color/fm_on_primary"
                app:backgroundTint="@color/fm_primary"
                app:icon="@android:drawable/ic_lock_lock"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <ImageButton
                android:id="@+id/btnAdminInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/fm_on_primary" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Tillbaka (replaces delete account) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteAccount"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/tillbaka"
        android:textAllCaps="false"
        android:textColor="@color/fm_on_primary"
        app:backgroundTint="@color/fm_primary"
        app:layout_constraintBottom_toTopOf="@id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:backgroundTint="@color/status_red"
        android:text="@string/logga_ut2"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>